<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineHeight" Value="1.1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
    </Style>

    <Style x:Key="HeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
    </Style>

    <Style x:Key="SubheaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
        <Setter Property="CharacterSpacing" Value="1.4"/>
        <Setter Property="Margin" Value="4,20,0,8"/>
    </Style>

    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
        <Setter Property="Margin" Value="4,14,0,6"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnPrimary}, Dark={StaticResource DOnPrimary}}"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LSecondaryContainer}, Dark={StaticResource DSecondaryContainer}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSecondaryContainer}, Dark={StaticResource DOnSecondaryContainer}}"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LErrorContainer}, Dark={StaticResource DErrorContainer}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnErrorContainer}, Dark={StaticResource DOnErrorContainer}}"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="Fab" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="HeightRequest" Value="64"/>
        <Setter Property="WidthRequest" Value="64"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="VerticalOptions" Value="End"/>
        <Setter Property="Margin" Value="0,0,20,24"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource SoftShadow}" Opacity="0.3" Radius="14" Offset="0,6"/>
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.92"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LSurfaceContainerLow}, Dark={StaticResource DSurfaceContainer}}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CardElevated" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LPrimaryContainer}, Dark={StaticResource DPrimaryContainer}}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LOutlineVariant}, Dark={StaticResource DOutlineVariant}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LSurfaceContainerHighest}, Dark={StaticResource DSurfaceContainerHigh}}"/>
        <Setter Property="Padding" Value="14,2"/>
    </Style>

    <Style x:Key="FieldInput" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="FieldPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="FieldDatePicker" TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LError}, Dark={StaticResource DError}}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="4,4,0,0"/>
    </Style>

    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
    </Style>

    <Style x:Key="RowSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
    </Style>

    <Style x:Key="RowValue" TargetType="Label">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
    </Style>

    <Style x:Key="Chevron" TargetType="Label">
        <Setter Property="Text" Value="&#x203A;"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOutline}, Dark={StaticResource DOutline}}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LSecondaryContainer}, Dark={StaticResource DSecondaryContainer}}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="PillText" TargetType="Label">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSecondaryContainer}, Dark={StaticResource DOnSecondaryContainer}}"/>
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LOutlineVariant}, Dark={StaticResource DOutlineVariant}}"/>
        <Setter Property="Margin" Value="20,0"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="Label">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"/>
    </Style>
    <Style x:Key="MetricHint" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}"/>
    </Style>

    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LOutlineVariant}, Dark={StaticResource DOutlineVariant}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LSurfaceContainerLow}, Dark={StaticResource DSurfaceContainerHigh}}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource SoftShadow}" Opacity="0.25" Radius="14" Offset="0,6" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="28" />
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource SoftShadow}" Opacity="0.3" Radius="16" Offset="0,8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LBackground}, Dark={StaticResource DBackground}}"/>
    </Style>

</ResourceDictionary>
