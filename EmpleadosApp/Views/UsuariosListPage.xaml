<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EmpleadosApp.Models"
             x:Class="EmpleadosApp.Views.UsuariosListPage"
             Shell.NavBarIsVisible="False"
             Title="Usuarios">

    <Grid>
        <Grid Padding="20,24,20,0" RowDefinitions="Auto,*" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="Usuarios del sistema" Style="{StaticResource DisplayLabel}" />
                <Label Text="Toca un usuario para editarlo" Style="{StaticResource SubheaderLabel}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <CollectionView x:Name="UsuariosCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnUsuarioSeleccionado">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24,48" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Sin usuarios" Style="{StaticResource RowTitle}" HorizontalOptions="Center" />
                            <Label Text="Crea el primero con el botón +." Style="{StaticResource SubheaderLabel}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Usuario">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="20,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            WidthRequest="48" HeightRequest="48"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LPrimaryContainer}, Dark={StaticResource DPrimaryContainer}}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Username, Converter={StaticResource Inicial}}"
                                               TextColor="{AppThemeBinding Light={StaticResource LOnPrimaryContainer}, Dark={StaticResource DOnPrimaryContainer}}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Username}" Style="{StaticResource RowTitle}" />
                                        <Label Text="{Binding NombreCompleto}" Style="{StaticResource RowSubtitle}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2" Style="{StaticResource Pill}">
                                        <Label Text="{Binding Estado}" Style="{StaticResource PillText}" />
                                    </Border>

                                    <Label Grid.Column="3" Style="{StaticResource Chevron}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divider}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" BackgroundColor="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </Border>

        </Grid>

        <Button Text="+" Style="{StaticResource Fab}" Clicked="OnNuevoUsuarioClicked" />
    </Grid>

</ContentPage>
