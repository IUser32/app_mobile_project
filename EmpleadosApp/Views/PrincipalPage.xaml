<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EmpleadosApp.ViewModels"
             x:DataType="vm:DashboardViewModel"
             x:Class="EmpleadosApp.Views.PrincipalPage"
             Shell.NavBarIsVisible="False"
             Title="Inicio">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,110" Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Panel de control" Style="{StaticResource DisplayLabel}" />
                        <Label Text="{Binding Saludo}" Style="{StaticResource SubheaderLabel}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Salir"
                            Style="{StaticResource QuietButton}"
                            VerticalOptions="Start"
                            Clicked="OnCerrarSesionClicked" />
                </Grid>

                <Border Style="{StaticResource HeroCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmpleadosTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="TOTAL DE EMPLEADOS"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1.4"
                               TextColor="White"
                               Opacity="0.9" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding TotalEmpleados}"
                               FontSize="56"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Grid.Row="2" Grid.Column="0"
                               Text="{Binding ResumenEmpleados}"
                               FontSize="13"
                               TextColor="White"
                               Opacity="0.9" />

                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                WidthRequest="64" HeightRequest="64"
                                StrokeThickness="0"
                                BackgroundColor="#33FFFFFF"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="&#x203A;"
                                   FontSize="34"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEmpleadosTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Activos" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding EmpleadosActivos}"
                                   Style="{StaticResource MetricValue}"
                                   TextColor="{AppThemeBinding Light={StaticResource LSuccess}, Dark={StaticResource DSuccess}}" />
                            <Label Text="{Binding EmpleadosInactivos, StringFormat='{0} inactivos'}" Style="{StaticResource MetricHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDepartamentosTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Áreas" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding TotalDepartamentos}" Style="{StaticResource MetricValue}" />
                            <Label Text="departamentos" Style="{StaticResource MetricHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCargosTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Cargos" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding TotalCargos}" Style="{StaticResource MetricValue}" />
                            <Label Text="puestos" Style="{StaticResource MetricHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUsuariosTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Usuarios" Style="{StaticResource MetricLabel}" />
                            <Label Text="{Binding TotalUsuarios}" Style="{StaticResource MetricValue}" />
                            <Label Text="con acceso" Style="{StaticResource MetricHint}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Label Text="EMPLEADOS POR ÁREA" Style="{StaticResource SectionLabel}" />

                <Border Style="{StaticResource StatCard}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="14"
                                             IsVisible="{Binding HayEmpleados}"
                                             BindableLayout.ItemsSource="{Binding EmpleadosPorDepartamento}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarraDepartamento">
                                    <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0"
                                               Text="{Binding Nombre}"
                                               Style="{StaticResource RowSubtitle}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="1"
                                                HeightRequest="14"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource LSurfaceContainerHighest}, Dark={StaticResource DSurfaceContainerHighest}}"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Peso, Converter={StaticResource Star}}" />
                                                    <ColumnDefinition Width="{Binding PesoResto, Converter={StaticResource Star}}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="7" />
                                                    </Border.StrokeShape>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Label Grid.Column="2"
                                               Text="{Binding Cantidad}"
                                               Style="{StaticResource RowTitle}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"
                                               WidthRequest="24" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Aún no hay empleados registrados."
                               Style="{StaticResource RowSubtitle}"
                               HorizontalOptions="Center"
                               Padding="0,8"
                               IsVisible="{Binding HayEmpleados, Converter={StaticResource Invertir}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="+"
                Style="{StaticResource Fab}"
                Clicked="OnNuevoEmpleadoClicked" />
    </Grid>

</ContentPage>
