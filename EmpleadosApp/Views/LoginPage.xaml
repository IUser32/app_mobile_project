<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EmpleadosApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="Iniciar sesión">

    <ScrollView>
        <Grid Padding="28" RowDefinitions="*,Auto,*">

            <VerticalStackLayout Grid.Row="1" Spacing="34" VerticalOptions="Center">

                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Image Source="logo.png"
                           WidthRequest="200"
                           HeightRequest="200"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="Inicia sesión para continuar"
                           Style="{StaticResource SubheaderLabel}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">

                    <Label Text="Usuario" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="UsuarioEntry"
                               Style="{StaticResource FieldInput}"
                               Placeholder="admin" />
                    </Border>

                    <Label Text="Contraseña" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="ContrasenaEntry"
                               Style="{StaticResource FieldInput}"
                               Placeholder="••••••••"
                               IsPassword="True" />
                    </Border>

                    <Button Text="Iniciar sesión"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnIniciarSesionClicked"
                            Margin="0,24,0,0" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
