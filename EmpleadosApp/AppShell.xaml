<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EmpleadosApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EmpleadosApp.Views"
    Title="EmpleadosApp"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LSurfaceContainer}, Dark={StaticResource DSurfaceContainer}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource LOnSurface}, Dark={StaticResource DOnSurface}}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource LSurfaceContainer}, Dark={StaticResource DSurfaceContainer}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource LPrimary}, Dark={StaticResource DPrimary}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource LOnSurfaceVariant}, Dark={StaticResource DOnSurfaceVariant}}">

    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="login"
                  Shell.FlyoutBehavior="Disabled"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False" />

    <TabBar>
        <Tab Title="Inicio" Route="inicio" Icon="tab_home.png">
            <ShellContent ContentTemplate="{DataTemplate views:PrincipalPage}" Route="principal" />
        </Tab>
        <Tab Title="Empleados" Route="empleados-tab" Icon="tab_people.png">
            <ShellContent ContentTemplate="{DataTemplate views:EmpleadosListPage}" Route="empleados" />
        </Tab>
        <Tab Title="Áreas" Route="departamentos-tab" Icon="tab_dept.png">
            <ShellContent ContentTemplate="{DataTemplate views:DepartamentosListPage}" Route="departamentos" />
        </Tab>
        <Tab Title="Cargos" Route="cargos-tab" Icon="tab_cargo.png">
            <ShellContent ContentTemplate="{DataTemplate views:CargosListPage}" Route="cargos" />
        </Tab>
        <Tab Title="Usuarios" Route="usuarios-tab" Icon="tab_user.png">
            <ShellContent ContentTemplate="{DataTemplate views:UsuariosListPage}" Route="usuarios" />
        </Tab>
    </TabBar>

</Shell>
